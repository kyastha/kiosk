# Public URL encoded in the permanent and payment QR codes. Use HTTPS on a school LAN.
PUBLIC_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000
SCHOOL_NAME="School Printing Service"
DATA_DIR=./data
# Set independent secrets with at least 32 characters. Use node scripts/setup-dev.mjs locally.
APP_SECRET=
AGENT_TOKEN=
ADMIN_USERNAME=admin
# At least 14 characters. Required only when the database has no administrator.
ADMIN_PASSWORD=
# Set to 1 only behind a single trusted reverse proxy with the API bound to loopback.
TRUST_PROXY=0
ALLOW_INSECURE_HTTP=false

# Optional. Supply all three values from the same Google Cloud project.
GOOGLE_CLIENT_ID=
GOOGLE_PICKER_API_KEY=
GOOGLE_PROJECT_NUMBER=

# Optional overrides for native installations. Programs must be on PATH otherwise.
# SOFFICE_PATH=/usr/bin/soffice
# PDFINFO_PATH=/usr/bin/pdfinfo
# RECEIPT_FONT=/usr/share/fonts/truetype/noto/NotoSansDevanagari-Regular.ttf
